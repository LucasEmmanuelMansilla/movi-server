# .gitignore para apps/server (Node / TypeScript)

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
out/
*.tsbuildinfo

# Environment variables
.env
.env.*.local
.env.local

# Test coverage and cache
coverage/
.nyc_output/
.cache/
jest.cache/

# OS files
.DS_Store
Thumbs.db

# IDE/editor
.vscode/
.idea/
*.code-workspace
*.sublime-*

# Misc
*.pid
*.seed
*.pid.lock
*.coverdata